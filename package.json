{
  "name": "stats-playground",
  "private": true,
  "version": "0.1.0",
  "description": "An ultra-lightweight, open-source, and extensible data analysis tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "benchmark:scatter": "node scripts/runScatterBudget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:distribution:typecheck": "tsc -p tests/tsconfig.contracts.json",
    "test:distribution:contracts": "tsx tests/distributionContracts.test.ts && tsx tests/distributionRunContract.test.ts && tsx tests/distributionArchive.test.ts && tsx tests/distributionIsolation.test.ts && tsx tests/distributionSnapshot.test.ts && tsx tests/distributionContinuousFitRun.test.ts",
    "test:distribution:adapter": "tsx tests/distributionGraphAdapter.test.ts",
    "test:distribution:compatibility": "tsx tests/distributionVisualCompatibility.test.ts",
    "test:distribution:report": "tsx tests/distributionReportWiring.test.ts",
    "test:distribution:golden": "tsx tests/distributionGolden.test.ts",
    "test:distribution:blackbox": "tsx tests/distributionBlackBox.test.ts",
    "test:distribution:ui": "playwright test -c playwright-ct.config.ts",
    "test:distribution": "npm run test:distribution:typecheck && npm run test:distribution:contracts && npm run test:distribution:compatibility && npm run test:distribution:adapter && npm run test:distribution:report && npm run test:distribution:golden && npm run test:distribution:blackbox && npm run test:distribution:ui"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "file:vendor/fortawesome-fontawesome-free-6.7.2.tgz",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "claygl": "file:vendor/claygl-1.3.0.tgz",
    "echarts": "file:vendor/echarts-5.6.0.tgz",
    "echarts-gl": "file:vendor/echarts-gl-2.0.9.tgz",
    "i18next": "^26.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "zrender": "file:vendor/zrender-5.6.1.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.55.0",
    "@playwright/test": "1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "4.20.5",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
